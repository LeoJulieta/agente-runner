{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/LeoJulieta/agente-runner/blob/main/docs/pr-d-v2-manifest.schema.json",
  "title": "PR D v2 frozen batch manifest",
  "description": "Proposed schema for review; not yet consumed by the production workflow. Do not execute batches from this file until the manifest inventory and acceptance tests are approved.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_version",
    "contract_path",
    "contract_sha256",
    "families"
  ],
  "properties": {
    "schema_version": { "const": "pr-d-v2-manifest/1" },
    "manifest_version": { "type": "string", "minLength": 1 },
    "contract_path": { "const": "docs/PR-D-DESIGN.md" },
    "contract_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "families": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "family_id",
          "hypothesis_ids",
          "m",
          "outcomes",
          "primary_contrasts",
          "windows",
          "method_version"
        ],
        "properties": {
          "family_id": { "type": "string", "minLength": 1 },
          "hypothesis_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^H[0-9]{3,}$"
            }
          },
          "m": { "type": "integer", "minimum": 1 },
          "outcomes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "primary_contrasts": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "windows": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "method_version": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
